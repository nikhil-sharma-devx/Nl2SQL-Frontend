# ── Required for production (Vercel → AWS) ───────────────────────────────────
# Full URL of your deployed AWS backend — no trailing slash.
# Example: https://api.yourdomain.com   or   http://<ec2-public-ip>:8000
VITE_API_BASE_URL=https://api.yourdomain.com

# ── Optional: Google OAuth ────────────────────────────────────────────────────
# Your Google OAuth 2.0 Client ID (from Google Cloud Console).
# Leave empty to disable Google login button.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
